# =============================================================================
# Probe Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.

# --- LLM Providers (Mode C: Map-Reduce) ---
# At least one provider must be configured for Mode C to work.
# Priority order is controlled by PROBE_LLM_PROVIDER.

# Google Gemini (free tier via Google AI Studio)
GEMINI_API_KEY=

# Groq Cloud (free tier)
GROQ_API_KEY=

# Ollama (local, no key needed — just set the base URL)
OLLAMA_BASE_URL=http://localhost:11434

# Provider priority (comma-separated, first available is used)
PROBE_LLM_PROVIDER=gemini,groq,ollama

# --- PostgreSQL Database ---
DATABASE_URL=postgresql+asyncpg://admin:video_pass@localhost:5432/probe

# --- MinIO Storage ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
MINIO_BUCKET=probe-projects
MINIO_SECURE=false

# --- Storage & Vector DB ---
PROBE_OUTPUT_DIR=./outputs
PROBE_CHROMA_PERSIST_DIR=./outputs/chromadb

# --- Limits ---
PROBE_MAX_FILE_SIZE_MB=10
PROBE_MAX_PROJECT_SIZE_MB=500
PROBE_MAX_CONCURRENT_LLM_CALLS=5

# --- Server ---
PROBE_HOST=0.0.0.0
PROBE_PORT=8000
PROBE_DEBUG=true
